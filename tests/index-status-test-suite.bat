; ======================================================================
; The index, status, ignore rules, and checkout.
; ======================================================================

(println crlf "index-status-test-suite")

(deffunction index-suite ()
  (bind ?repo (make-repo "index"))
  (bind ?idx (git-repository-index ?repo))
  (expect "a new index is empty" 0 (git-index-entrycount ?idx))
  (expect-true "git-index-path is the index file" (stringp (git-index-path ?idx)))
  (expect-true "git-index-version is 2 or more" (>= (git-index-version ?idx) 2))
  (expect "git-index-set-version takes 3" TRUE (git-index-set-version ?idx 3))
  (expect "git-index-has-conflicts is false" FALSE (git-index-has-conflicts ?idx))
  (bind ?owner (git-index-owner ?idx))
  (expect "git-index-owner is the repository" (git-repository-path ?repo) (git-repository-path ?owner))

  (write-file ?repo "a.txt" (str-cat "aaa" ?*nl*))
  (write-file ?repo "b.txt" (str-cat "bbb" ?*nl*))
  (expect "git-index-add-bypath stages a file" TRUE (git-index-add-bypath ?idx "a.txt"))
  (expect "and the count grows" 1 (git-index-entrycount ?idx))
  (expect "git-index-find finds it" 0 (git-index-find ?idx "a.txt"))
  (expect "and answers FALSE for one that is not there" FALSE (git-index-find ?idx "b.txt"))
  (bind ?entry (git-index-get-byindex ?idx 0))
  (expect "git-index-get-byindex answers path, id, mode, size, stage" 5 (length$ ?entry))
  (expect "with the path" "a.txt" (nth$ 1 ?entry))
  (expect "the mode" GIT_FILEMODE_BLOB (nth$ 3 ?entry))
  (expect "the size" 4 (nth$ 4 ?entry))
  (expect "and stage zero" 0 (nth$ 5 ?entry))
  (expect "git-index-get-bypath answers the same" ?entry (git-index-get-bypath ?idx "a.txt"))
  (bind ?r (git-index-get-bypath ?idx "b.txt"))
  (expect "and refuses a path not in the index" FALSE ?r)
  (bind ?fact (git-index-entry-to-fact ?idx 0 index-entry))
  (expect "git-index-entry-to-fact asserts the entry" "a.txt" (fact-slot-value ?fact path))
  (expect "with its mode" GIT_FILEMODE_BLOB (fact-slot-value ?fact mode))
  (retract ?fact)
  (expect "and answers FALSE past the end" FALSE (git-index-entry-to-fact ?idx 5 index-entry))

  (expect "git-index-add-all takes a pathspec" TRUE (git-index-add-all ?idx (create$ "*.txt")))
  (expect "and stages the rest" 2 (git-index-entrycount ?idx))
  (expect "git-index-write writes it" TRUE (git-index-write ?idx))
  (expect "git-index-read reads it back" TRUE (git-index-read ?idx))
  (expect-true "git-index-checksum is an id after a write" (stringp (git-index-checksum ?idx)))
  (bind ?tree-id (git-index-write-tree ?idx))
  (expect-true "git-index-write-tree writes a tree" (eq (str-length ?tree-id) 40))
  (expect "git-index-write-tree-to writes the same one" ?tree-id (git-index-write-tree-to ?idx ?repo))

  (expect "git-index-remove-bypath unstages a file" TRUE (git-index-remove-bypath ?idx "b.txt"))
  (expect "leaving one" 1 (git-index-entrycount ?idx))
  (expect "git-index-remove takes a stage" TRUE (git-index-remove ?idx "a.txt" 0))
  (expect "leaving none" 0 (git-index-entrycount ?idx))
  (bind ?tree (git-tree-lookup ?repo ?tree-id))
  (expect "git-index-read-tree loads a tree" TRUE (git-index-read-tree ?idx ?tree))
  (expect "and both are back" 2 (git-index-entrycount ?idx))
  (git-tree-free ?tree)
  (write-file ?repo "a.txt" (str-cat "changed" ?*nl*))
  (expect "git-index-update-all refreshes what changed" TRUE (git-index-update-all ?idx (create$ "*")))
  (expect "to the new size" 8 (nth$ 4 (git-index-get-bypath ?idx "a.txt")))
  (expect "git-index-remove-all takes a pathspec" TRUE (git-index-remove-all ?idx (create$ "b.txt")))
  (expect "leaving one" 1 (git-index-entrycount ?idx))
  (system "mkdir -p tests/tmp/index/sub")
  (write-file ?repo "sub/c.txt" (str-cat "c" ?*nl*))
  (git-index-add-all ?idx (create$ "sub"))
  (expect "git-index-remove-directory removes a directory" TRUE (git-index-remove-directory ?idx "sub" 0))
  (expect "leaving one again" 1 (git-index-entrycount ?idx))
  (expect "git-index-clear empties it" TRUE (git-index-clear ?idx))
  (expect "to nothing" 0 (git-index-entrycount ?idx))
  (expect "git-index-conflict-cleanup on a clean index succeeds" TRUE (git-index-conflict-cleanup ?idx))
  (git-index-free ?idx)

  ; A standalone index.
  (bind ?loose (git-index-new))
  (expect "git-index-new makes an in-memory index" 0 (git-index-entrycount ?loose))
  (expect "with no owner" nil (git-index-owner ?loose))
  (git-index-free ?loose)
  (bind ?ondisk (git-index-open "tests/tmp/index/.git/index"))
  (expect-true "git-index-open reads a file" (external-addressp ?ondisk))
  (git-index-free ?ondisk)

  ; Status.
  (commit-all ?repo "everything")
  (bind ?st (git-status-list-new ?repo))
  (expect "a clean tree has no status entries" 0 (git-status-list-entrycount ?st))
  (git-status-list-free ?st)
  (write-file ?repo "a.txt" (str-cat "modified" ?*nl*))
  (write-file ?repo "new.txt" (str-cat "new" ?*nl*))
  (bind ?st (git-status-list-new ?repo))
  (expect "a modified and an untracked file are two entries" 2 (git-status-list-entrycount ?st))
  (bind ?e (git-status-byindex ?st 0))
  (expect "git-status-byindex answers path, old path, then the flags" 3 (length$ ?e))
  (expect "the modified file first" "a.txt" (nth$ 1 ?e))
  (expect "and no old path" nil (nth$ 2 ?e))
  (expect "with GIT_STATUS_WT_MODIFIED" GIT_STATUS_WT_MODIFIED (nth$ 3 ?e))
  (bind ?r (git-status-byindex ?st 9))
  (expect "and refuses a position past the end" FALSE ?r)
  (bind ?fact (git-status-entry-to-fact ?st 1 status-entry))
  (expect "git-status-entry-to-fact asserts an entry" "new.txt" (fact-slot-value ?fact path))
  (expect "with its flags" (create$ GIT_STATUS_WT_NEW) (fact-slot-value ?fact status))
  (retract ?fact)
  (expect "and answers FALSE past the end" FALSE (git-status-entry-to-fact ?st 9 status-entry))
  (git-status-list-free ?st)
  (bind ?st (git-status-list-new ?repo (create$ GIT_STATUS_OPT_INCLUDE_UNMODIFIED) GIT_STATUS_SHOW_WORKDIR_ONLY))
  (expect "flags and show are taken" 3 (git-status-list-entrycount ?st))
  (git-status-list-free ?st)
  (bind ?st (git-status-list-new ?repo (create$ GIT_STATUS_OPT_INCLUDE_UNTRACKED) GIT_STATUS_SHOW_INDEX_AND_WORKDIR (create$ "new.txt")))
  (expect "and a pathspec" 1 (git-status-list-entrycount ?st))
  (git-status-list-free ?st)
  (expect "git-status-file answers one file's flags" (create$ GIT_STATUS_WT_NEW) (git-status-file ?repo "new.txt"))
  (expect "git-status-should-ignore is false for it" FALSE (git-status-should-ignore ?repo "new.txt"))
  (expect "git-ignore-add-rule adds a rule" TRUE (git-ignore-add-rule ?repo (str-cat "*.log" ?*nl*)))
  (expect "git-ignore-path-is-ignored honours it" TRUE (git-ignore-path-is-ignored ?repo "x.log"))
  (expect "git-status-should-ignore agrees" TRUE (git-status-should-ignore ?repo "x.log"))
  (expect "git-ignore-clear-internal-rules drops it" TRUE (git-ignore-clear-internal-rules ?repo))
  (expect "and the path is no longer ignored" FALSE (git-ignore-path-is-ignored ?repo "x.log"))

  ; A checkout restores the modified file.
  (expect "git-checkout-head with force restores the tree" TRUE (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE)))
  (expect "and the modification is gone" (create$ GIT_STATUS_CURRENT) (git-status-file ?repo "a.txt"))
  (write-file ?repo "a.txt" (str-cat "modified again" ?*nl*))
  (expect "git-checkout-index with paths restores one file" TRUE
          (git-checkout-index ?repo nil (create$ GIT_CHECKOUT_FORCE) (create$ "a.txt")))
  (expect "and it is clean again" (create$ GIT_STATUS_CURRENT) (git-status-file ?repo "a.txt"))
  (bind ?head (git-revparse-single ?repo "HEAD"))
  (write-file ?repo "a.txt" (str-cat "and again" ?*nl*))
  (expect "git-checkout-tree takes a commit" TRUE (git-checkout-tree ?repo ?head (create$ GIT_CHECKOUT_FORCE)))
  (expect "and restores the file" (create$ GIT_STATUS_CURRENT) (git-status-file ?repo "a.txt"))

  ; Reset.
  (write-file ?repo "a.txt" (str-cat "staged" ?*nl*))
  (bind ?idx (git-repository-index ?repo))
  (git-index-add-bypath ?idx "a.txt")
  (git-index-write ?idx)
  (git-index-free ?idx)
  (expect "the change is staged" (create$ GIT_STATUS_INDEX_MODIFIED) (git-status-file ?repo "a.txt"))
  (expect "git-reset-default unstages a path" TRUE (git-reset-default ?repo ?head (create$ "a.txt")))
  (expect "leaving it modified in the tree" (create$ GIT_STATUS_WT_MODIFIED) (git-status-file ?repo "a.txt"))
  (expect "git-reset hard puts everything back" TRUE (git-reset ?repo ?head GIT_RESET_HARD))
  (expect "and the file is current" (create$ GIT_STATUS_CURRENT) (git-status-file ?repo "a.txt"))
  (git-commit-free ?head)

  (git-repository-free ?repo))

(index-suite)
