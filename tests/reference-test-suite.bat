; ======================================================================
; References, branches, and reflogs.
; ======================================================================

(println crlf "reference-test-suite")

(deffunction reference-suite ()
  (bind ?repo (make-repo "refs"))
  (bind ?first (commit-file ?repo "a" "a" "first"))
  (bind ?second (commit-file ?repo "b" "b" "second"))

  (bind ?main (git-reference-lookup ?repo "refs/heads/main"))
  (expect "git-reference-name is the full name" "refs/heads/main" (git-reference-name ?main))
  (expect "git-reference-shorthand is the short one" "main" (git-reference-shorthand ?main))
  (expect "git-reference-type is direct" GIT_REFERENCE_DIRECT (git-reference-type ?main))
  (expect "git-reference-target is the commit" ?second (git-reference-target ?main))
  (expect "git-reference-target-peel is nil for a plain reference" nil (git-reference-target-peel ?main))
  (expect "git-reference-symbolic-target is nil for a direct reference" nil (git-reference-symbolic-target ?main))
  (expect "git-reference-is-branch" TRUE (git-reference-is-branch ?main))
  (expect "git-reference-is-remote" FALSE (git-reference-is-remote ?main))
  (expect "git-reference-is-tag" FALSE (git-reference-is-tag ?main))
  (expect "git-reference-is-note" FALSE (git-reference-is-note ?main))
  (expect "git-reference-cmp of a reference with itself" 0 (git-reference-cmp ?main ?main))
  (bind ?dup (git-reference-dup ?main))
  (expect "git-reference-dup copies it" "refs/heads/main" (git-reference-name ?dup))
  (git-reference-free ?dup)

  (bind ?head (git-reference-lookup ?repo "HEAD"))
  (expect "HEAD is symbolic" GIT_REFERENCE_SYMBOLIC (git-reference-type ?head))
  (expect "pointing at main" "refs/heads/main" (git-reference-symbolic-target ?head))
  (expect "and has no direct target" nil (git-reference-target ?head))
  (bind ?resolved (git-reference-resolve ?head))
  (expect "git-reference-resolve follows it" "refs/heads/main" (git-reference-name ?resolved))
  (git-reference-free ?resolved)
  (bind ?peeled (git-reference-peel ?head GIT_OBJECT_COMMIT))
  (expect "git-reference-peel reaches the commit" ?second (git-commit-id ?peeled))
  (git-commit-free ?peeled)
  (bind ?peeled (git-reference-peel ?head))
  (expect "and with no type, whatever is there" GIT_OBJECT_COMMIT (git-object-type ?peeled))
  (git-object-free ?peeled)
  (git-reference-free ?head)

  (bind ?dwim (git-reference-dwim ?repo "main"))
  (expect "git-reference-dwim takes a shorthand" "refs/heads/main" (git-reference-name ?dwim))
  (git-reference-free ?dwim)
  (expect "git-reference-name-to-id resolves a name" ?second (git-reference-name-to-id ?repo "refs/heads/main"))
  (bind ?r (git-reference-name-to-id ?repo "refs/heads/nothing"))
  (expect "and refuses one that is not there" FALSE ?r)

  ; Create references.
  (bind ?old (git-reference-create ?repo "refs/heads/old" ?first))
  (expect "git-reference-create makes a direct reference" ?first (git-reference-target ?old))
  (bind ?r (git-reference-create ?repo "refs/heads/old" ?second))
  (expect "and refuses to overwrite one" FALSE ?r)
  (bind ?forced (git-reference-create ?repo "refs/heads/old" ?second TRUE "forced"))
  (expect "unless forced" ?second (git-reference-target ?forced))
  ; A reference object keeps the value that it was read with. libgit2 rejects
  ; a move of a reference that changed after the read.
  (bind ?r (git-reference-set-target ?old ?first "moved back"))
  (expect "git-reference-set-target refuses a reference that is stale" FALSE ?r)
  (git-reference-free ?old)
  (bind ?moved (git-reference-set-target ?forced ?first "moved back"))
  (expect "git-reference-set-target answers the moved reference" ?first (git-reference-target ?moved))
  (git-reference-free ?forced)
  (bind ?renamed (git-reference-rename ?moved "refs/heads/older" FALSE "renamed"))
  (expect "git-reference-rename answers the new one" "refs/heads/older" (git-reference-name ?renamed))
  (git-reference-free ?moved)
  (expect "git-reference-has-log is true for a branch" TRUE (git-reference-has-log ?repo "refs/heads/older"))
  (bind ?log (git-reflog-read ?repo "refs/heads/older"))
  (expect-true "git-reflog-read answers the entries, four elements each"
               (and (>= (length$ ?log) 4) (eq (mod (length$ ?log) 4) 0)))
  (expect "the newest first, with its new id" ?first (nth$ 2 ?log))
  (expect "git-reflog-delete removes the log" TRUE (git-reflog-delete ?repo "refs/heads/older"))
  (expect "and git-reflog-read answers nothing" (create$) (git-reflog-read ?repo "refs/heads/older"))
  (expect "git-reference-delete removes it" TRUE (git-reference-delete ?renamed))
  (git-reference-free ?renamed)

  (bind ?sym (git-reference-symbolic-create ?repo "refs/heads/alias" "refs/heads/main"))
  (expect "git-reference-symbolic-create makes a symbolic one" "refs/heads/main" (git-reference-symbolic-target ?sym))
  (bind ?resym (git-reference-symbolic-set-target ?sym "refs/heads/nothing" "retargeted"))
  (expect "git-reference-symbolic-set-target moves it" "refs/heads/nothing" (git-reference-symbolic-target ?resym))
  (git-reference-free ?resym)
  (git-reference-free ?sym)
  (expect "git-reference-remove deletes by name" TRUE (git-reference-remove ?repo "refs/heads/alias"))

  (expect "git-reference-list has what is left" (create$ "refs/heads/main") (git-reference-list ?repo))
  (expect "git-reference-list-glob filters" (create$ "refs/heads/main") (git-reference-list-glob ?repo "refs/heads/*"))
  (expect "and finds nothing for a glob that matches nothing" (create$) (git-reference-list-glob ?repo "refs/tags/*"))
  (expect "git-reference-is-valid-name accepts a good name" TRUE (git-reference-is-valid-name "refs/heads/ok"))
  (expect "and refuses a bad one" FALSE (git-reference-is-valid-name "refs/heads/not ok"))

  ; Branches.
  (bind ?c (git-commit-lookup ?repo ?first))
  (bind ?feature (git-branch-create ?repo "feature" ?c))
  (expect "git-branch-create makes a branch" "refs/heads/feature" (git-reference-name ?feature))
  (expect "git-branch-name is the short name" "feature" (git-branch-name ?feature))
  (expect "git-branch-is-head is false for it" FALSE (git-branch-is-head ?feature))
  (expect "and true for main" TRUE (git-branch-is-head ?main))
  (expect "git-branch-is-checked-out likewise" TRUE (git-branch-is-checked-out ?main))
  (expect "git-branch-upstream is nil when none is set" nil (git-branch-upstream ?feature))
  (expect "git-branch-set-upstream takes a local branch" TRUE (git-branch-set-upstream ?feature "main"))
  (bind ?up (git-branch-upstream ?feature))
  (expect "and git-branch-upstream answers it" "refs/heads/main" (git-reference-name ?up))
  (git-reference-free ?up)
  (expect "git-branch-upstream-name names it" "refs/heads/main" (git-branch-upstream-name ?repo "refs/heads/feature"))
  (expect "git-branch-upstream-remote is . for a local upstream" "." (git-branch-upstream-remote ?repo "refs/heads/feature"))
  (expect "git-branch-upstream-merge is the merge target" "refs/heads/main" (git-branch-upstream-merge ?repo "refs/heads/feature"))
  (bind ?r (git-branch-remote-name ?repo "refs/heads/feature"))
  (expect "git-branch-remote-name refuses a local branch" FALSE ?r)
  (expect "git-branch-set-upstream takes nil to unset" TRUE (git-branch-set-upstream ?feature nil))
  (expect "git-branch-list lists both" (create$ "feature" "main") (git-branch-list ?repo))
  (expect "git-branch-list takes a type" (create$) (git-branch-list ?repo GIT_BRANCH_REMOTE))
  (bind ?r (git-branch-create ?repo "feature" ?c))
  (expect "git-branch-create refuses a name in use" FALSE ?r)
  (bind ?forced (git-branch-create ?repo "feature" ?c TRUE))
  (expect-true "unless forced" (external-addressp ?forced))
  (git-reference-free ?forced)
  (bind ?looked (git-branch-lookup ?repo "feature"))
  (expect "git-branch-lookup finds it" "refs/heads/feature" (git-reference-name ?looked))
  (git-reference-free ?looked)
  (bind ?r (git-branch-lookup ?repo "feature" GIT_BRANCH_REMOTE))
  (expect "and not as a remote branch" FALSE ?r)
  (bind ?moved (git-branch-move ?feature "topic"))
  (expect "git-branch-move renames it" "topic" (git-branch-name ?moved))
  (git-reference-free ?feature)
  (expect "git-branch-delete removes it" TRUE (git-branch-delete ?moved))
  (git-reference-free ?moved)
  (expect "and it is gone" (create$ "main") (git-branch-list ?repo))
  (bind ?r (git-branch-delete ?main))
  (expect "git-branch-delete refuses the current branch" FALSE ?r)
  (expect "git-branch-is-valid-name accepts a good name" TRUE (git-branch-is-valid-name "ok"))
  (expect "and refuses a bad one" FALSE (git-branch-is-valid-name "-bad"))

  (bind ?annotated (git-annotated-commit-from-ref ?repo ?main))
  (bind ?fromann (git-branch-create-from-annotated ?repo "from-annotated" ?annotated))
  (expect "git-branch-create-from-annotated makes a branch" ?second (git-reference-target ?fromann))
  (git-reference-free ?fromann)
  (git-annotated-commit-free ?annotated)

  (git-commit-free ?c)
  (git-reference-free ?main)
  (git-repository-free ?repo))

(reference-suite)
