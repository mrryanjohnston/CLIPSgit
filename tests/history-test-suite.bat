; ======================================================================
; History walks, revision specs, describe, blame, and notes.
; ======================================================================

(println crlf "history-test-suite")

(deffunction history-suite ()
  (bind ?repo (make-repo "history"))
  (bind ?c1 (commit-file ?repo "a.txt" (format nil "one%n") "first"))
  (bind ?c2 (commit-file ?repo "a.txt" (format nil "one%ntwo%n") "second"))
  (bind ?c3 (commit-file ?repo "a.txt" (format nil "one%ntwo%nthree%n") "third"))

  ; Walk.
  (bind ?walk (git-revwalk-new ?repo))
  (expect "git-revwalk-push-head starts at HEAD" TRUE (git-revwalk-push-head ?walk))
  (expect "git-revwalk-next answers the newest" ?c3 (git-revwalk-next ?walk))
  (expect "then the next" ?c2 (git-revwalk-next ?walk))
  (expect "then the first" ?c1 (git-revwalk-next ?walk))
  (expect "then FALSE" FALSE (git-revwalk-next ?walk))
  (expect "git-revwalk-reset clears it" TRUE (git-revwalk-reset ?walk))
  (expect "git-revwalk-sorting takes flags" TRUE (git-revwalk-sorting ?walk (create$ GIT_SORT_TOPOLOGICAL GIT_SORT_REVERSE)))
  (expect "git-revwalk-push takes an id" TRUE (git-revwalk-push ?walk ?c3))
  (expect "git-revwalk-hide takes one too" TRUE (git-revwalk-hide ?walk ?c1))
  (expect "and reversed, the oldest unhidden comes first" ?c2 (git-revwalk-next ?walk))
  (expect "then the newest" ?c3 (git-revwalk-next ?walk))
  (git-revwalk-reset ?walk)
  (git-revwalk-sorting ?walk GIT_SORT_NONE)
  (expect "git-revwalk-push-ref takes a name" TRUE (git-revwalk-push-ref ?walk "refs/heads/main"))
  (expect "git-revwalk-hide-ref takes one too" TRUE (git-revwalk-hide-ref ?walk "refs/heads/main"))
  (expect "hiding what was pushed leaves nothing" FALSE (git-revwalk-next ?walk))
  (git-revwalk-reset ?walk)
  (expect "git-revwalk-push-glob takes a glob" TRUE (git-revwalk-push-glob ?walk "refs/heads/*"))
  (expect "git-revwalk-hide-glob takes one too" TRUE (git-revwalk-hide-glob ?walk "refs/tags/*"))
  (expect "git-revwalk-hide-head hides HEAD" TRUE (git-revwalk-hide-head ?walk))
  (expect "leaving nothing" FALSE (git-revwalk-next ?walk))
  (git-revwalk-reset ?walk)
  (expect "git-revwalk-push-range takes a range" TRUE (git-revwalk-push-range ?walk (str-cat ?c1 ".." ?c3)))
  (expect "git-revwalk-simplify-first-parent succeeds" TRUE (git-revwalk-simplify-first-parent ?walk))
  (expect "and the range has two" ?c3 (git-revwalk-next ?walk))
  (expect "then one" ?c2 (git-revwalk-next ?walk))
  (expect "then none" FALSE (git-revwalk-next ?walk))
  (bind ?r (git-revwalk-push-ref ?walk "refs/heads/nothing"))
  (expect "git-revwalk-push-ref refuses a name that is not there" FALSE ?r)
  (git-revwalk-free ?walk)

  ; Revision specs.
  (bind ?obj (git-revparse-single ?repo "HEAD~1"))
  (expect "git-revparse-single reads HEAD~1" ?c2 (git-object-id ?obj))
  (git-object-free ?obj)
  (bind ?obj (git-revparse-single ?repo "HEAD^{tree}"))
  (expect "and peels to a tree" GIT_OBJECT_TREE (git-object-type ?obj))
  (git-tree-free ?obj)
  (bind ?r (git-revparse-single ?repo "nothing"))
  (expect "and refuses nonsense" FALSE ?r)
  (bind ?ext (git-revparse-ext ?repo "main"))
  (expect "git-revparse-ext answers the object and the reference" 2 (length$ ?ext))
  (expect "the object" ?c3 (git-object-id (nth$ 1 ?ext)))
  (expect "the reference" "refs/heads/main" (git-reference-name (nth$ 2 ?ext)))
  (git-object-free (nth$ 1 ?ext))
  (git-reference-free (nth$ 2 ?ext))
  (bind ?ext (git-revparse-ext ?repo ?c1))
  (expect "and nil for a reference when there was none" nil (nth$ 2 ?ext))
  (git-object-free (nth$ 1 ?ext))
  (bind ?range (git-revparse ?repo (str-cat ?c1 ".." ?c3)))
  (expect "git-revparse answers from, to and flags" 3 (length$ ?range))
  (expect "from" ?c1 (git-object-id (nth$ 1 ?range)))
  (expect "to" ?c3 (git-object-id (nth$ 2 ?range)))
  (expect "and a range flag" GIT_REVSPEC_RANGE (nth$ 3 ?range))
  (git-object-free (nth$ 1 ?range))
  (git-object-free (nth$ 2 ?range))
  (bind ?single (git-revparse ?repo "HEAD"))
  (expect "a single spec has no to" nil (nth$ 2 ?single))
  (expect "and a single flag" GIT_REVSPEC_SINGLE (nth$ 3 ?single))
  (git-object-free (nth$ 1 ?single))

  ; Describe.
  (bind ?head (git-commit-lookup ?repo ?c3))
  (bind ?r (git-describe-commit ?head))
  (expect-true "git-describe-commit with no tags falls back to the id" (eq (str-index ?r ?c3) 1))
  (git-tag-create-lightweight ?repo "v1" ?head)
  (expect "git-describe-commit finds a tag" "v1" (git-describe-commit ?head GIT_DESCRIBE_TAGS))
  (expect-true "and the long form carries the id" (> (str-index "-g" (git-describe-commit ?head GIT_DESCRIBE_TAGS TRUE)) 0))
  (expect "git-describe-workdir describes a clean tree" "v1" (git-describe-workdir ?repo GIT_DESCRIBE_TAGS))
  (write-file ?repo "a.txt" (str-cat "dirty" ?*nl*))
  (expect "and a dirty one" "v1-dirty" (git-describe-workdir ?repo GIT_DESCRIBE_TAGS))
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))

  ; Blame.
  (bind ?blame (git-blame-file ?repo "a.txt"))
  (expect "git-blame-hunkcount is one per commit" 3 (git-blame-hunkcount ?blame))
  (bind ?hunk (git-blame-get-hunk-byindex ?blame 0))
  (expect "git-blame-get-hunk-byindex answers eight values" 8 (length$ ?hunk))
  (expect "one line in the first hunk" 1 (nth$ 1 ?hunk))
  (expect "from the first commit" ?c1 (nth$ 2 ?hunk))
  (expect "starting at line one" 1 (nth$ 3 ?hunk))
  (expect "by the author" "Test User" (nth$ 4 ?hunk))
  (expect "in the same path" "a.txt" (nth$ 7 ?hunk))
  (bind ?byline (git-blame-get-hunk-byline ?blame 3))
  (expect "git-blame-get-hunk-byline finds the third line's commit" ?c3 (nth$ 2 ?byline))
  (bind ?r (git-blame-get-hunk-byindex ?blame 9))
  (expect "and refuses a hunk past the end" FALSE ?r)
  (bind ?r (git-blame-get-hunk-byline ?blame 99))
  (expect "and a line past the end" FALSE ?r)
  (git-blame-free ?blame)
  (bind ?fp (git-blame-file ?repo "a.txt" (create$ GIT_BLAME_FIRST_PARENT)))
  (expect "git-blame-file takes flags" 3 (git-blame-hunkcount ?fp))
  (git-blame-free ?fp)
  (bind ?r (git-blame-file ?repo "nothing.txt"))
  (expect "git-blame-file refuses a path that is not there" FALSE ?r)

  ; Notes.
  (expect "git-note-default-ref is refs/notes/commits" "refs/notes/commits" (git-note-default-ref ?repo))
  (expect "git-note-read of a commit without one is nil" nil (git-note-read ?repo ?c3))
  (bind ?note (git-note-create ?repo ?c3 (str-cat "a note" ?*nl*) nil nil))
  (expect-true "git-note-create answers the note's id" (eq (str-length ?note) 40))
  (expect "and git-note-read reads it" (str-cat "a note" ?*nl*) (git-note-read ?repo ?c3))
  (bind ?r (git-note-create ?repo ?c3 (str-cat "another" ?*nl*) nil nil))
  (expect "a second note on the same commit is refused" FALSE ?r)
  (expect-true "unless forced" (stringp (git-note-create ?repo ?c3 (str-cat "another" ?*nl*) nil nil nil TRUE)))
  (expect "git-note-read takes a notes reference" (str-cat "another" ?*nl*) (git-note-read ?repo ?c3 "refs/notes/commits"))
  (expect "git-note-remove removes it" TRUE (git-note-remove ?repo ?c3 nil nil))
  (expect "and it is gone" nil (git-note-read ?repo ?c3))
  (bind ?noteref (git-reference-lookup ?repo "refs/notes/commits"))
  (expect "the notes reference is a note reference" TRUE (git-reference-is-note ?noteref))
  (git-reference-free ?noteref)

  ; The object database.
  (bind ?odb (git-repository-odb ?repo))
  (expect "git-odb-exists knows a commit" TRUE (git-odb-exists ?odb ?c3))
  (expect "and not a made-up id" FALSE (git-odb-exists ?odb "0123456789abcdef0123456789abcdef01234567"))
  (bind ?hdr (git-odb-read-header ?odb ?c3))
  (expect "git-odb-read-header says what it is" GIT_OBJECT_COMMIT (nth$ 1 ?hdr))
  (expect-true "and how big" (> (nth$ 2 ?hdr) 100))
  (expect-true "git-odb-read reads the raw commit" (eq (str-index "tree " (git-odb-read ?odb ?c3)) 1))
  (bind ?written (git-odb-write ?odb (str-cat "raw blob" ?*nl*) GIT_OBJECT_BLOB))
  (expect "git-odb-write writes a blob" (git-odb-hash (str-cat "raw blob" ?*nl*) GIT_OBJECT_BLOB) ?written)
  (expect "which git-odb-exists sees" TRUE (git-odb-exists ?odb ?written))
  (expect "git-odb-hashfile hashes a file" (git-repository-hashfile ?repo "a.txt")
          (git-odb-hashfile "tests/tmp/history/a.txt" GIT_OBJECT_BLOB))
  (expect "git-odb-refresh succeeds" TRUE (git-odb-refresh ?odb))
  (git-odb-free ?odb)

  (git-commit-free ?head)
  (git-repository-free ?repo))

(history-suite)
