; ======================================================================
; Merge, cherry-pick, revert, and stash.
; ======================================================================

(println crlf "merge-test-suite")

(deffunction merge-suite ()
  (bind ?repo (make-repo "merge"))
  (bind ?base (commit-file ?repo "a.txt" (str-cat "base" ?*nl*) "base"))
  (bind ?base-commit (git-commit-lookup ?repo ?base))

  ; A branch with a commit of its own, and main with a different one.
  (bind ?branch (git-branch-create ?repo "topic" ?base-commit))
  (git-reference-free ?branch)
  (git-repository-set-head ?repo "refs/heads/topic")
  (bind ?theirs (commit-file ?repo "b.txt" (str-cat "theirs" ?*nl*) "on topic"))
  (git-repository-set-head ?repo "refs/heads/main")
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))
  (bind ?ours (commit-file ?repo "c.txt" (str-cat "ours" ?*nl*) "on main"))

  (expect "git-merge-base is the base" ?base (git-merge-base ?repo ?ours ?theirs))
  (bind ?unrelated (make-repo "unrelated"))
  (bind ?other (commit-file ?unrelated "z" "z" "z"))
  (git-repository-free ?unrelated)
  (bind ?r (git-merge-base ?repo ?ours ?ours))
  (expect "and a commit with itself" ?ours ?r)

  ; Analysis, then the merge.
  (bind ?topic (git-reference-lookup ?repo "refs/heads/topic"))
  (bind ?head (git-annotated-commit-from-ref ?repo ?topic))
  (expect "git-annotated-commit-id is the commit" ?theirs (git-annotated-commit-id ?head))
  (expect "git-annotated-commit-ref is the reference" "refs/heads/topic" (git-annotated-commit-ref ?head))
  (bind ?analysis (git-merge-analysis ?repo (create$ ?head)))
  (expect "git-merge-analysis answers the flags and then the preference" 2 (length$ ?analysis))
  (expect "a normal merge" GIT_MERGE_ANALYSIS_NORMAL (nth$ 1 ?analysis))
  (expect "with no preference" GIT_MERGE_PREFERENCE_NONE (nth$ 2 ?analysis))
  (expect "git-merge merges" TRUE (git-merge ?repo (create$ ?head)))
  (expect "and the repository is mid-merge" GIT_REPOSITORY_STATE_MERGE (git-repository-state ?repo))
  (expect-true "with a merge message" (stringp (git-repository-message ?repo)))
  (bind ?idx (git-repository-index ?repo))
  (expect "with no conflicts" FALSE (git-index-has-conflicts ?idx))
  (expect "and their file staged" 3 (git-index-entrycount ?idx))
  (git-index-free ?idx)
  ; The merge commit is written by hand, with both heads as parents.
  (bind ?idx (git-repository-index ?repo))
  (bind ?tree (git-tree-lookup ?repo (git-index-write-tree ?idx)))
  (git-index-free ?idx)
  (bind ?oc (git-commit-lookup ?repo ?ours))
  (bind ?tc (git-commit-lookup ?repo ?theirs))
  (bind ?merge (git-commit-create ?repo "HEAD" nil nil "merged" ?tree (create$ ?oc ?tc)))
  (git-tree-free ?tree)
  (git-commit-free ?oc)
  (git-commit-free ?tc)
  (bind ?m (git-commit-lookup ?repo ?merge))
  (expect "the merge commit has two parents" 2 (git-commit-parentcount ?m))
  (expect "the second being theirs" ?theirs (git-commit-parent-id ?m 1))
  (git-commit-free ?m)
  (expect "git-repository-message-remove removes the message" TRUE (git-repository-message-remove ?repo))
  (expect "git-repository-state-cleanup ends the merge" TRUE (git-repository-state-cleanup ?repo))
  (expect "and the state is none" GIT_REPOSITORY_STATE_NONE (git-repository-state ?repo))
  (git-annotated-commit-free ?head)
  (git-reference-free ?topic)

  ; The other ways to name an annotated commit.
  (bind ?byid (git-annotated-commit-lookup ?repo ?theirs))
  (expect "git-annotated-commit-lookup takes an id" ?theirs (git-annotated-commit-id ?byid))
  (expect "and has no reference" nil (git-annotated-commit-ref ?byid))
  (git-annotated-commit-free ?byid)
  (bind ?byspec (git-annotated-commit-from-revspec ?repo "topic"))
  (expect "git-annotated-commit-from-revspec takes a spec" ?theirs (git-annotated-commit-id ?byspec))
  (git-annotated-commit-free ?byspec)

  ; Up to date: a merge of a commit that is already merged.
  (bind ?again (git-annotated-commit-lookup ?repo ?theirs))
  (expect "merging what is already in is up to date"
          GIT_MERGE_ANALYSIS_UP_TO_DATE (nth$ 1 (git-merge-analysis ?repo (create$ ?again))))
  (git-annotated-commit-free ?again)
  (bind ?r (git-merge-analysis ?repo (create$)))
  (expect "git-merge-analysis refuses no heads" FALSE ?r)

  ; Merge trees and commits without a change to the working directory.
  (bind ?oc (git-commit-lookup ?repo ?ours))
  (bind ?tc (git-commit-lookup ?repo ?theirs))
  (bind ?merged (git-merge-commits ?repo ?oc ?tc))
  (expect "git-merge-commits answers an index with both sides" 3 (git-index-entrycount ?merged))
  (expect "and no conflicts" FALSE (git-index-has-conflicts ?merged))
  (git-index-free ?merged)
  (bind ?bt (git-commit-tree ?base-commit))
  (bind ?ot (git-commit-tree ?oc))
  (bind ?tt (git-commit-tree ?tc))
  (bind ?merged (git-merge-trees ?repo ?bt ?ot ?tt))
  (expect "git-merge-trees does the same" 3 (git-index-entrycount ?merged))
  (git-index-free ?merged)
  (git-tree-free ?bt)
  (git-tree-free ?ot)
  (git-tree-free ?tt)

  ; A conflict.
  (bind ?cb (git-branch-create ?repo "conflict" ?base-commit))
  (git-reference-free ?cb)
  (git-repository-set-head ?repo "refs/heads/conflict")
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))
  (bind ?cthem (commit-file ?repo "a.txt" (str-cat "their line" ?*nl*) "their change"))
  (git-repository-set-head ?repo "refs/heads/main")
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))
  (bind ?cours (commit-file ?repo "a.txt" (str-cat "our line" ?*nl*) "our change"))
  (bind ?ch (git-annotated-commit-lookup ?repo ?cthem))
  (expect "git-merge with a conflict still answers TRUE" TRUE (git-merge ?repo (create$ ?ch)))
  (bind ?idx (git-repository-index ?repo))
  (expect "and the index has conflicts" TRUE (git-index-has-conflicts ?idx))
  (expect "git-status-file says conflicted" (create$ GIT_STATUS_CONFLICTED) (git-status-file ?repo "a.txt"))
  (expect "git-index-conflict-remove resolves one path" TRUE (git-index-conflict-remove ?idx "a.txt"))
  (expect "and the index has none" FALSE (git-index-has-conflicts ?idx))
  (git-index-free ?idx)
  (git-annotated-commit-free ?ch)
  (git-repository-state-cleanup ?repo)
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))
  (bind ?fail (git-annotated-commit-lookup ?repo ?cthem))
  (bind ?r (git-merge ?repo (create$ ?fail) (create$ GIT_MERGE_FAIL_ON_CONFLICT)))
  (expect "and with GIT_MERGE_FAIL_ON_CONFLICT it is refused" FALSE ?r)
  (git-annotated-commit-free ?fail)
  (git-repository-state-cleanup ?repo)
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))

  ; Cherry-pick and revert.
  (expect "git-cherrypick applies a commit" TRUE (git-cherrypick ?repo ?tc))
  (expect "and leaves the repository mid-cherrypick" GIT_REPOSITORY_STATE_CHERRYPICK (git-repository-state ?repo))
  (git-repository-state-cleanup ?repo)
  (bind ?cp (commit-all ?repo "picked"))
  (bind ?cpc (git-commit-lookup ?repo ?cp))
  (expect "git-revert undoes one" TRUE (git-revert ?repo ?cpc))
  (expect "and leaves the repository mid-revert" GIT_REPOSITORY_STATE_REVERT (git-repository-state ?repo))
  (git-repository-state-cleanup ?repo)
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))
  (bind ?head (git-commit-lookup ?repo (git-reference-name-to-id ?repo "HEAD")))
  (bind ?picked (git-cherrypick-commit ?repo ?tc ?head))
  (expect-true "git-cherrypick-commit answers an index" (external-addressp ?picked))
  (git-index-free ?picked)
  (bind ?reverted (git-revert-commit ?repo ?cpc ?head))
  (expect-true "git-revert-commit answers an index" (external-addressp ?reverted))
  (git-index-free ?reverted)
  (bind ?r (git-revert-commit ?repo ?cpc ?head 1))
  (expect "and refuses a mainline on a commit that is not a merge" FALSE ?r)
  (git-commit-free ?head)
  (git-commit-free ?cpc)
  (git-commit-free ?oc)
  (git-commit-free ?tc)

  ; Stashes.
  (write-file ?repo "a.txt" (str-cat "stash me" ?*nl*))
  (expect "git-stash-list is empty" (create$) (git-stash-list ?repo))
  (bind ?stash (git-stash-save ?repo nil "work in progress"))
  (expect-true "git-stash-save answers the stash id" (eq (str-length ?stash) 40))
  (expect "and the file is clean" (create$ GIT_STATUS_CURRENT) (git-status-file ?repo "a.txt"))
  (bind ?list (git-stash-list ?repo))
  (expect "git-stash-list has the message and the id" 2 (length$ ?list))
  (expect-true "the message" (> (str-index "work in progress" (nth$ 1 ?list)) 0))
  (expect "the id" ?stash (nth$ 2 ?list))
  (expect "git-stash-apply puts it back" TRUE (git-stash-apply ?repo))
  (expect "and the file is modified" (create$ GIT_STATUS_WT_MODIFIED) (git-status-file ?repo "a.txt"))
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))
  (expect "git-stash-pop puts it back and drops it" TRUE (git-stash-pop ?repo 0 GIT_STASH_APPLY_DEFAULT))
  (expect "leaving none" (create$) (git-stash-list ?repo))
  (git-stash-save ?repo nil "second" (create$ GIT_STASH_INCLUDE_UNTRACKED))
  (expect "git-stash-drop drops one" TRUE (git-stash-drop ?repo 0))
  (bind ?r (git-stash-drop ?repo 0))
  (expect "and refuses when there is none" FALSE ?r)
  (bind ?r (git-stash-save ?repo nil "nothing"))
  (expect "git-stash-save with nothing to stash is refused" FALSE ?r)

  (git-commit-free ?base-commit)
  (git-repository-free ?repo))

(merge-suite)
