; ======================================================================
; Worktrees and submodules.
; ======================================================================

(println crlf "worktree-submodule-test-suite")

(deffunction worktree-suite ()
  (bind ?repo (make-repo "wt"))
  (bind ?c (commit-file ?repo "a.txt" (str-cat "a" ?*nl*) "first"))
  (expect "a repository starts with no worktrees" (create$) (git-worktree-list ?repo))

  (bind ?wt (git-worktree-add ?repo "side" "tests/tmp/wt-side"))
  (expect-true "git-worktree-add makes one" (external-addressp ?wt))
  (expect "git-worktree-name is the name" "side" (git-worktree-name ?wt))
  (expect-true "git-worktree-path is the path" (> (str-index "wt-side" (git-worktree-path ?wt)) 0))
  (expect "git-worktree-validate is happy" TRUE (git-worktree-validate ?wt))
  (expect "git-worktree-list has it" (create$ "side") (git-worktree-list ?repo))
  (expect "git-worktree-is-locked is false" FALSE (git-worktree-is-locked ?wt))
  (expect "git-worktree-lock locks it" TRUE (git-worktree-lock ?wt "busy"))
  (expect "and git-worktree-is-locked answers the reason" "busy" (git-worktree-is-locked ?wt))
  (expect "git-worktree-unlock unlocks it" TRUE (git-worktree-unlock ?wt))
  (expect "git-worktree-is-prunable is false while it is there" FALSE (git-worktree-is-prunable ?wt))
  (expect "but true with GIT_WORKTREE_PRUNE_VALID" TRUE (git-worktree-is-prunable ?wt (create$ GIT_WORKTREE_PRUNE_VALID)))

  (bind ?side (git-repository-open-from-worktree ?wt))
  (expect "git-repository-open-from-worktree opens it" TRUE (git-repository-is-worktree ?side))
  (expect "at the same commit" ?c (git-reference-name-to-id ?side "HEAD"))
  (expect-true "with a common directory that is the main repository's"
               (eq (git-repository-commondir ?side) (git-repository-path ?repo)))
  (bind ?back (git-worktree-open-from-repository ?side))
  (expect "git-worktree-open-from-repository finds the worktree" "side" (git-worktree-name ?back))
  (git-worktree-free ?back)
  (git-repository-free ?side)
  (bind ?r (git-worktree-open-from-repository ?repo))
  (expect "and refuses a repository that is not a worktree" FALSE ?r)

  (bind ?looked (git-worktree-lookup ?repo "side"))
  (expect "git-worktree-lookup finds it" "side" (git-worktree-name ?looked))
  (git-worktree-free ?looked)
  (bind ?r (git-worktree-lookup ?repo "nothing"))
  (expect "and refuses one that is not there" FALSE ?r)

  (expect "git-worktree-prune with the working tree removes it" TRUE
          (git-worktree-prune ?wt (create$ GIT_WORKTREE_PRUNE_VALID GIT_WORKTREE_PRUNE_WORKING_TREE)))
  (expect "and the list is empty" (create$) (git-worktree-list ?repo))
  (git-worktree-free ?wt)

  (bind ?main (git-reference-lookup ?repo "refs/heads/main"))
  (bind ?r (git-worktree-add ?repo "locked" "tests/tmp/wt-locked" nil TRUE))
  (expect-true "git-worktree-add takes a lock" (stringp (git-worktree-is-locked ?r)))
  (git-worktree-free ?r)
  (git-reference-free ?main)

  (git-repository-free ?repo))

(deffunction submodule-suite ()
  (bind ?sub (make-repo "sub"))
  (bind ?subc (commit-file ?sub "s.txt" (str-cat "s" ?*nl*) "in the submodule"))
  (bind ?sub-path (git-repository-workdir ?sub))
  (git-repository-free ?sub)

  (bind ?repo (make-repo "super"))
  (commit-file ?repo "a.txt" (str-cat "a" ?*nl*) "first")
  (expect "a repository starts with no submodules" (create$) (git-submodule-list ?repo))

  (bind ?sm (git-submodule-add-setup ?repo ?sub-path "lib"))
  (expect-true "git-submodule-add-setup makes one" (external-addressp ?sm))
  (expect "git-submodule-name is the path" "lib" (git-submodule-name ?sm))
  (expect "git-submodule-path is the path" "lib" (git-submodule-path ?sm))
  (expect "git-submodule-url is the url" ?sub-path (git-submodule-url ?sm))
  (expect "git-submodule-branch is nil" nil (git-submodule-branch ?sm))
  (expect "git-submodule-head-id is nil before it is committed" nil (git-submodule-head-id ?sm))
  (expect "git-submodule-ignore is none" GIT_SUBMODULE_IGNORE_NONE (git-submodule-ignore ?sm))
  (bind ?clone (git-submodule-clone ?sm))
  (expect "git-submodule-clone clones it into place" ?subc (git-reference-name-to-id ?clone "HEAD"))
  (git-repository-free ?clone)
  (expect "git-submodule-add-finalize commits the setup to the index" TRUE (git-submodule-add-finalize ?sm))
  (expect "git-submodule-add-to-index writes it again" TRUE (git-submodule-add-to-index ?sm TRUE))
  (git-submodule-free ?sm)
  (commit-all ?repo "add submodule")
  (expect "git-submodule-list has it" (create$ "lib") (git-submodule-list ?repo))
  (bind ?sm (git-submodule-lookup ?repo "lib"))
  (expect "git-submodule-lookup finds it" "lib" (git-submodule-name ?sm))
  (expect "git-submodule-index-id is the submodule's commit" ?subc (git-submodule-index-id ?sm))
  (expect "git-submodule-wd-id agrees" ?subc (git-submodule-wd-id ?sm))
  (expect "and git-submodule-head-id is set once committed" ?subc (git-submodule-head-id ?sm))
  (bind ?status (git-submodule-status ?repo "lib"))
  (expect-true "git-submodule-status says it is in HEAD" (member$ GIT_SUBMODULE_STATUS_IN_HEAD ?status))
  (expect-true "and in the index" (member$ GIT_SUBMODULE_STATUS_IN_INDEX ?status))
  (expect "git-submodule-init succeeds" TRUE (git-submodule-init ?sm))
  (expect "git-submodule-sync succeeds" TRUE (git-submodule-sync ?sm))
  (expect "git-submodule-reload succeeds" TRUE (git-submodule-reload ?sm TRUE))
  (expect "git-submodule-update succeeds" TRUE (git-submodule-update ?sm TRUE))
  (bind ?opened (git-submodule-open ?sm))
  (expect "git-submodule-open opens the submodule's repository" ?subc (git-reference-name-to-id ?opened "HEAD"))
  (git-repository-free ?opened)
  (git-submodule-free ?sm)
  (bind ?r (git-submodule-lookup ?repo "nothing"))
  (expect "git-submodule-lookup refuses a name that is not there" FALSE ?r)

  ; A clone of the superproject has a record of the submodule, but nothing is
  ; checked out for it. This is the purpose of repo-init, init, and update.
  (bind ?clone2 (git-clone (git-repository-workdir ?repo) "tests/tmp/super-clone"))
  (bind ?csm (git-submodule-lookup ?clone2 "lib"))
  (expect-true "in a clone the submodule is uninitialised"
               (member$ GIT_SUBMODULE_STATUS_WD_UNINITIALIZED (git-submodule-status ?clone2 "lib")))
  (expect "git-submodule-init copies the url into the clone's config" TRUE (git-submodule-init ?csm))
  (bind ?inited (git-submodule-repo-init ?csm))
  (expect "git-submodule-repo-init makes an empty repository in place" TRUE (git-repository-is-empty ?inited))
  (git-repository-free ?inited)
  (expect "git-submodule-update fetches and checks out" TRUE (git-submodule-update ?csm TRUE))
  (git-submodule-reload ?csm TRUE)
  (expect "and the working directory is at the commit" ?subc (git-submodule-wd-id ?csm))
  (git-submodule-free ?csm)
  (git-repository-free ?clone2)

  (expect "git-submodule-set-url changes the url" TRUE (git-submodule-set-url ?repo "lib" "/elsewhere"))
  (bind ?sm (git-submodule-lookup ?repo "lib"))
  (expect "and it reads back" "/elsewhere" (git-submodule-url ?sm))
  (git-submodule-free ?sm)

  (git-repository-free ?repo))

(worktree-suite)
(submodule-suite)
