; ======================================================================
; Commits: create them, read them, and change them into facts.
; ======================================================================

(println crlf "commit-test-suite")

(deffunction commit-suite ()
  (bind ?repo (make-repo "commits"))
  (bind ?first (commit-file ?repo "a.txt" (str-cat "one" ?*nl*) "first commit"))
  (bind ?second (commit-file ?repo "b.txt" (str-cat "two" ?*nl*) (str-cat "second commit" (format nil "%n%nWith a body.%n"))))

  (expect-true "git-commit-create answers an id" (eq (str-length ?first) 40))
  (bind ?c (git-commit-lookup ?repo ?second))
  (expect "git-commit-id is the id it was looked up by" ?second (git-commit-id ?c))
  (expect "git-commit-summary is the first line" "second commit" (git-commit-summary ?c))
  (expect "git-commit-body is what follows" "With a body." (git-commit-body ?c))
  (expect-true "git-commit-message is the whole thing"
               (eq (str-index "With a body." (git-commit-message ?c)) 16))
  (expect "git-commit-message-raw is the same here" (git-commit-message ?c) (git-commit-message-raw ?c))
  (expect "git-commit-message-encoding is nil for UTF-8" nil (git-commit-message-encoding ?c))
  (expect-true "git-commit-raw-header starts with the tree" (eq (str-index "tree " (git-commit-raw-header ?c)) 1))
  (expect "git-commit-header-field reads a header" (git-commit-tree-id ?c) (git-commit-header-field ?c "tree"))
  (expect "and answers nil for one that is not there" nil (git-commit-header-field ?c "nothing"))
  (expect "git-commit-parentcount is one" 1 (git-commit-parentcount ?c))
  (expect "git-commit-parent-id is the first commit" ?first (git-commit-parent-id ?c 0))
  (bind ?r (git-commit-parent-id ?c 5))
  (expect "and refuses a parent that is not there" FALSE ?r)
  (expect-true "git-commit-time is recent" (> (git-commit-time ?c) 1700000000))
  (expect-true "git-commit-time-offset is an integer" (integerp (git-commit-time-offset ?c)))

  (bind ?author (git-commit-author ?c))
  (expect "git-commit-author is the configured user" "Test User" (git-signature-name ?author))
  (expect "with the configured email" "test@example.com" (git-signature-email ?author))
  (expect "git-signature-time matches the commit" (git-commit-time ?c) (git-signature-time ?author))
  (expect "git-signature-offset matches the commit" (git-commit-time-offset ?c) (git-signature-offset ?author))
  (bind ?r (git-signature-free ?author))
  (expect "a borrowed signature is not freed on its own" FALSE ?r)
  (bind ?committer (git-commit-committer ?c))
  (expect "git-commit-committer is the same person" "Test User" (git-signature-name ?committer))

  (bind ?parent (git-commit-parent ?c 0))
  (expect "git-commit-parent is the first commit" ?first (git-commit-id ?parent))
  (expect "which has no parents" 0 (git-commit-parentcount ?parent))
  (git-commit-free ?parent)
  (bind ?ancestor (git-commit-nth-gen-ancestor ?c 1))
  (expect "git-commit-nth-gen-ancestor goes back a generation" ?first (git-commit-id ?ancestor))
  (git-commit-free ?ancestor)

  (bind ?tree (git-commit-tree ?c))
  (expect "git-commit-tree is the tree by the id" (git-commit-tree-id ?c) (git-tree-id ?tree))
  (expect "and it has both files" 2 (git-tree-entrycount ?tree))
  (git-tree-free ?tree)

  ; The object functions accept a commit.
  (expect "git-object-id agrees with git-commit-id" ?second (git-object-id ?c))
  (expect "git-object-type is a commit" GIT_OBJECT_COMMIT (git-object-type ?c))
  (expect-true "git-object-short-id is a prefix" (eq (str-index (git-object-short-id ?c) ?second) 1))
  (bind ?peeled (git-object-peel ?c GIT_OBJECT_TREE))
  (expect "git-object-peel reaches the tree" (git-commit-tree-id ?c) (git-tree-id ?peeled))
  (git-tree-free ?peeled)

  ; Prefix lookups.
  (bind ?byprefix (git-commit-lookup-prefix ?repo (sub-string 1 10 ?second)))
  (expect "git-commit-lookup-prefix finds it by ten characters" ?second (git-commit-id ?byprefix))
  (git-commit-free ?byprefix)
  (bind ?r (git-commit-lookup-prefix ?repo "abc"))
  (expect "and refuses fewer than four" FALSE ?r)
  (bind ?any (git-object-lookup-prefix ?repo (sub-string 1 12 ?second)))
  (expect "git-object-lookup-prefix finds a commit by prefix" ?second (git-object-id ?any))
  (git-object-free ?any)
  (bind ?r (git-object-lookup-prefix ?repo (sub-string 1 12 ?second) GIT_OBJECT_TREE))
  (expect "and refuses it as a tree" FALSE ?r)
  (bind ?any (git-object-lookup ?repo ?second))
  (expect "git-object-lookup finds a commit as a commit" GIT_OBJECT_COMMIT (git-object-type ?any))
  (git-object-free ?any)
  (bind ?r (git-object-lookup ?repo ?second GIT_OBJECT_BLOB))
  (expect "and refuses it as a blob" FALSE ?r)
  (bind ?r (git-tree-lookup ?repo ?second))
  (expect "git-tree-lookup refuses a commit id" FALSE ?r)

  ; Facts and instances.
  (bind ?fact (git-commit-to-fact ?c commit))
  (expect-true "git-commit-to-fact asserts a fact" (factp ?fact))
  (expect "with the id" ?second (fact-slot-value ?fact id))
  (expect "the tree" (git-commit-tree-id ?c) (fact-slot-value ?fact tree))
  (expect "the parents" (create$ ?first) (fact-slot-value ?fact parents))
  (expect "the summary" "second commit" (fact-slot-value ?fact summary))
  (expect "the body" "With a body." (fact-slot-value ?fact body))
  (expect "the author" "Test User" (fact-slot-value ?fact author-name))
  (expect "the author's email" "test@example.com" (fact-slot-value ?fact author-email))
  (expect "the author's time" (git-commit-time ?c) (fact-slot-value ?fact author-time))
  (expect "the committer" "Test User" (fact-slot-value ?fact committer-name))
  (retract ?fact)

  (bind ?brief (git-commit-to-fact ?c commit-brief))
  (expect "a shape with fewer slots gets fewer" "second commit" (fact-slot-value ?brief summary))
  (expect "and keeps its own defaults" none (fact-slot-value ?brief tag))
  (retract ?brief)

  (bind ?r (git-commit-to-fact ?c commit-wrong-type))
  (expect "a slot of the wrong type is a refusal" FALSE ?r)
  (bind ?r (git-commit-to-fact ?c no-such-template))
  (expect "and so is a template that is not there" FALSE ?r)

  (bind ?inst (git-commit-to-instance ?c COMMIT))
  (expect-true "git-commit-to-instance makes an instance" (instancep ?inst))
  (expect "with the id" ?second (send ?inst get-id))
  (expect "and the parents" (create$ ?first) (send ?inst get-parents))
  (send ?inst delete)
  (bind ?named (git-commit-to-instance ?c COMMIT [second]))
  (expect "and takes a name" [second] (instance-name ?named))
  (send ?named delete)

  ; Amend.
  (bind ?amended (git-commit-amend ?c "HEAD" nil nil "amended message" nil))
  (expect-true "git-commit-amend answers a new id" (and (stringp ?amended) (neq ?amended ?second)))
  (expect "and HEAD moved to it" ?amended (git-reference-name-to-id ?repo "HEAD"))
  (bind ?a (git-commit-lookup ?repo ?amended))
  (expect "with the new message" "amended message" (git-commit-summary ?a))
  (expect "and the same tree" (git-commit-tree-id ?c) (git-commit-tree-id ?a))
  (git-commit-free ?a)
  (git-commit-free ?c)

  ; A commit with an explicit signature, and the buffer form.
  (bind ?sig (git-signature-new "Someone Else" "else@example.com" 1700000000 60))
  (expect "git-signature-new keeps the time" 1700000000 (git-signature-time ?sig))
  (expect "and the offset" 60 (git-signature-offset ?sig))
  (bind ?dup (git-signature-dup ?sig))
  (expect "git-signature-dup copies it" "Someone Else" (git-signature-name ?dup))
  (git-signature-free ?dup)
  (bind ?parsed (git-signature-from-buffer "A B <a@b.c> 1700000000 +0100"))
  (expect "git-signature-from-buffer parses one" "a@b.c" (git-signature-email ?parsed))
  (git-signature-free ?parsed)
  (bind ?default (git-signature-default ?repo))
  (expect "git-signature-default is the configured user" "Test User" (git-signature-name ?default))
  (git-signature-free ?default)
  (bind ?head (git-commit-lookup ?repo (git-reference-name-to-id ?repo "HEAD")))
  (bind ?tree (git-commit-tree ?head))
  (bind ?buf (git-commit-create-buffer ?repo ?sig ?sig "buffered" ?tree (create$ ?head)))
  (expect-true "git-commit-create-buffer writes the commit as text"
               (and (stringp ?buf) (> (str-index "Someone Else" ?buf) 0)))
  (bind ?third (git-commit-create ?repo "HEAD" ?sig ?sig "third" ?tree (create$ ?head)))
  (bind ?t (git-commit-lookup ?repo ?third))
  (bind ?a (git-commit-author ?t))
  (expect "git-commit-create takes a signature" "Someone Else" (git-signature-name ?a))
  (expect "at the time it says" 1700000000 (git-commit-time ?t))
  (git-commit-free ?t)
  (git-tree-free ?tree)
  (git-commit-free ?head)
  (git-signature-free ?sig)

  ; A commit with nil signatures in a repository with no identity is a
  ; rejected call, not a crash.
  (bind ?anon (make-repo "anon"))
  (bind ?cfg (git-repository-config ?anon))
  (git-config-delete-entry ?cfg "user.name")
  (git-config-delete-entry ?cfg "user.email")
  (git-config-free ?cfg)
  (bind ?r (git-signature-default ?anon))
  (expect-true "git-signature-default without an identity is refused, or falls back to the global one"
               (or (eq ?r FALSE) (external-addressp ?r)))
  (if ?r then (git-signature-free ?r))
  (git-repository-free ?anon)

  (git-repository-free ?repo))

(commit-suite)
