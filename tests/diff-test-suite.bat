; ======================================================================
; Diffs, patches, and how to apply them.
; ======================================================================

(println crlf "diff-test-suite")

(deffunction diff-suite ()
  (bind ?repo (make-repo "diffs"))
  (bind ?first (commit-file ?repo "a.txt" (format nil "one%ntwo%nthree%n") "first"))
  (bind ?second (commit-file ?repo "a.txt" (format nil "one%n2%nthree%nfour%n") "second"))
  (bind ?c1 (git-commit-lookup ?repo ?first))
  (bind ?c2 (git-commit-lookup ?repo ?second))
  (bind ?t1 (git-commit-tree ?c1))
  (bind ?t2 (git-commit-tree ?c2))

  (bind ?diff (git-diff-tree-to-tree ?repo ?t1 ?t2))
  (expect "git-diff-tree-to-tree has one delta" 1 (git-diff-num-deltas ?diff))
  (expect "git-diff-num-deltas-of-type counts modifications" 1 (git-diff-num-deltas-of-type ?diff GIT_DELTA_MODIFIED))
  (expect "and no additions" 0 (git-diff-num-deltas-of-type ?diff GIT_DELTA_ADDED))
  (bind ?delta (git-diff-get-delta ?diff 0))
  (expect "git-diff-get-delta answers six values" 6 (length$ ?delta))
  (expect "the status" GIT_DELTA_MODIFIED (nth$ 1 ?delta))
  (expect "the old path" "a.txt" (nth$ 2 ?delta))
  (expect "the new path" "a.txt" (nth$ 3 ?delta))
  (expect "and not binary" FALSE (nth$ 6 ?delta))
  (bind ?r (git-diff-get-delta ?diff 3))
  (expect "and refuses a delta past the end" FALSE ?r)
  (bind ?fact (git-diff-delta-to-fact ?diff 0 delta))
  (expect "git-diff-delta-to-fact asserts a delta" GIT_DELTA_MODIFIED (fact-slot-value ?fact status))
  (expect "with the path" "a.txt" (fact-slot-value ?fact new-path))
  (retract ?fact)
  (expect "and answers FALSE past the end" FALSE (git-diff-delta-to-fact ?diff 3 delta))
  (expect "git-diff-stats is files, insertions, deletions" (create$ 1 2 1) (git-diff-stats ?diff))
  (expect-true "git-diff-stats-to-buf renders them"
               (> (str-index "1 file changed" (git-diff-stats-to-buf ?diff)) 0))
  (expect-true "and takes a format" (> (str-length (git-diff-stats-to-buf ?diff GIT_DIFF_STATS_SHORT 40)) 0))
  (bind ?text (git-diff-to-buf ?diff))
  (expect-true "git-diff-to-buf writes a patch" (> (str-index "-two" ?text) 0))
  (expect "git-diff-to-buf takes a format" (format nil "a.txt%n") (git-diff-to-buf ?diff GIT_DIFF_FORMAT_NAME_ONLY))
  (expect-true "git-diff-patchid answers an id" (eq (str-length (git-diff-patchid ?diff)) 40))
  (expect "git-diff-is-sorted-icase is false" FALSE (git-diff-is-sorted-icase ?diff))
  (expect "git-diff-find-similar succeeds" TRUE (git-diff-find-similar ?diff))

  ; Patches.
  (bind ?patch (git-patch-from-diff ?diff 0))
  (expect "git-patch-num-hunks is one" 1 (git-patch-num-hunks ?patch))
  (expect "git-patch-line-stats is context, added, deleted" (create$ 2 2 1) (git-patch-line-stats ?patch))
  (expect "git-patch-get-delta agrees with the diff" ?delta (git-patch-get-delta ?patch))
  (expect-true "git-patch-size is positive" (> (git-patch-size ?patch) 0))
  (expect "git-patch-to-buf is the patch text" ?text (git-patch-to-buf ?patch))
  (bind ?hunk (git-patch-get-hunk ?patch 0))
  (expect "git-patch-get-hunk answers six values" 6 (length$ ?hunk))
  (expect "the old start" 1 (nth$ 1 ?hunk))
  (expect "the old lines" 3 (nth$ 2 ?hunk))
  (expect "the new lines" 4 (nth$ 4 ?hunk))
  (expect "the header" (format nil "@@ -1,3 +1,4 @@%n") (nth$ 5 ?hunk))
  (expect "and the line count" 5 (nth$ 6 ?hunk))
  (expect "git-patch-num-lines-in-hunk agrees" 5 (git-patch-num-lines-in-hunk ?patch 0))
  (bind ?line (git-patch-get-line-in-hunk ?patch 0 1))
  (expect "git-patch-get-line-in-hunk answers origin, old, new, content" 4 (length$ ?line))
  (expect "a deleted line" "-" (nth$ 1 ?line))
  (expect "from the old file" 2 (nth$ 2 ?line))
  (expect "with no new line number" -1 (nth$ 3 ?line))
  (expect "and the content" (format nil "two%n") (nth$ 4 ?line))
  (bind ?r (git-patch-get-hunk ?patch 4))
  (expect "and refuses a hunk past the end" FALSE ?r)
  (git-patch-free ?patch)

  ; Apply the patch text again.
  (bind ?parsed (git-diff-from-buffer ?text))
  (expect "git-diff-from-buffer parses a patch" 1 (git-diff-num-deltas ?parsed))
  (bind ?applied (git-apply-to-tree ?repo ?t1 ?parsed))
  (expect-true "git-apply-to-tree answers an index" (external-addressp ?applied))
  (expect "whose tree is the second commit's" (git-tree-id ?t2) (git-index-write-tree-to ?applied ?repo))
  (git-index-free ?applied)
  (git-checkout-tree ?repo ?c1 (create$ GIT_CHECKOUT_FORCE))
  (expect "git-apply applies it to the working directory" TRUE (git-apply ?repo ?parsed))
  ; The checkout moved the index to the first commit, and the working
  ; directory has the patch. So both parts of the status are set.
  (expect-true "which is now modified" (member$ GIT_STATUS_WT_MODIFIED (git-status-file ?repo "a.txt")))
  ; A checkout compares the target with the working directory. After the
  ; apply, the file already matches the second commit. So a checkout would
  ; keep the index where the first checkout put it. A hard reset puts both
  ; back.
  (git-reset ?repo ?c2 GIT_RESET_HARD)
  (git-diff-free ?parsed)

  ; Merge diffs.
  (bind ?empty (git-diff-tree-to-tree ?repo ?t1 ?t1))
  (expect "a tree against itself has no deltas" 0 (git-diff-num-deltas ?empty))
  (expect "git-diff-merge folds one diff into another" TRUE (git-diff-merge ?empty ?diff))
  (expect "and the delta is there" 1 (git-diff-num-deltas ?empty))
  (git-diff-free ?empty)
  (git-diff-free ?diff)

  ; Options: reverse and a pathspec.
  (bind ?rev (git-diff-tree-to-tree ?repo ?t1 ?t2 (create$ GIT_DIFF_REVERSE)))
  (expect "GIT_DIFF_REVERSE swaps the sides" (create$ 1 1 2) (git-diff-stats ?rev))
  (git-diff-free ?rev)
  (bind ?none (git-diff-tree-to-tree ?repo ?t1 ?t2 GIT_DIFF_NORMAL (create$ "b.txt")))
  (expect "a pathspec that matches nothing gives no deltas" 0 (git-diff-num-deltas ?none))
  (git-diff-free ?none)
  (bind ?ctx (git-diff-tree-to-tree ?repo ?t1 ?t2 GIT_DIFF_NORMAL (create$) 0 0))
  (bind ?p (git-patch-from-diff ?ctx 0))
  (expect "context lines can be set to zero" (create$ 0 2 1) (git-patch-line-stats ?p))
  (git-patch-free ?p)
  (git-diff-free ?ctx)
  (bind ?nil-tree (git-diff-tree-to-tree ?repo nil ?t1))
  (expect "a nil old tree is an empty tree" 1 (git-diff-num-deltas-of-type ?nil-tree GIT_DELTA_ADDED))
  (git-diff-free ?nil-tree)

  ; The other diff forms.
  (write-file ?repo "a.txt" (str-cat "workdir" ?*nl*))
  (bind ?wd (git-diff-index-to-workdir ?repo nil))
  (expect "git-diff-index-to-workdir sees the change" 1 (git-diff-num-deltas ?wd))
  (git-diff-free ?wd)
  (bind ?tw (git-diff-tree-to-workdir ?repo ?t2))
  (expect "git-diff-tree-to-workdir sees it too" 1 (git-diff-num-deltas ?tw))
  (git-diff-free ?tw)
  (bind ?twi (git-diff-tree-to-workdir-with-index ?repo ?t1))
  (expect "and git-diff-tree-to-workdir-with-index" 1 (git-diff-num-deltas ?twi))
  (git-diff-free ?twi)
  (bind ?ti (git-diff-tree-to-index ?repo ?t1 nil))
  (expect "git-diff-tree-to-index compares with the index" 1 (git-diff-num-deltas ?ti))
  (git-diff-free ?ti)
  (bind ?idx (git-repository-index ?repo))
  (bind ?ii (git-diff-index-to-index ?repo ?idx ?idx))
  (expect "git-diff-index-to-index of an index with itself is empty" 0 (git-diff-num-deltas ?ii))
  (git-diff-free ?ii)
  (git-index-free ?idx)
  (git-checkout-head ?repo (create$ GIT_CHECKOUT_FORCE))

  ; Patches from blobs and buffers.
  (bind ?b1 (git-blob-lookup ?repo (git-tree-entry-id (git-tree-entry-byname ?t1 "a.txt"))))
  (bind ?b2 (git-blob-lookup ?repo (git-tree-entry-id (git-tree-entry-byname ?t2 "a.txt"))))
  (bind ?bp (git-patch-from-blobs ?b1 "a.txt" ?b2 "a.txt"))
  (expect "git-patch-from-blobs diffs two blobs" (create$ 2 2 1) (git-patch-line-stats ?bp))
  (git-patch-free ?bp)
  (bind ?np (git-patch-from-blobs nil nil ?b2 "a.txt"))
  (expect "with nil for a side that is not there" GIT_DELTA_ADDED (nth$ 1 (git-patch-get-delta ?np)))
  (git-patch-free ?np)
  (git-blob-free ?b1)
  (git-blob-free ?b2)
  (bind ?tp (git-patch-from-buffers (str-cat "a" ?*nl* "b" ?*nl*) "f" (str-cat "a" ?*nl* "c" ?*nl*) "f"))
  (expect "git-patch-from-buffers diffs two strings" (create$ 1 1 1) (git-patch-line-stats ?tp))
  (git-patch-free ?tp)

  (git-tree-free ?t1)
  (git-tree-free ?t2)
  (git-commit-free ?c1)
  (git-commit-free ?c2)
  (git-repository-free ?repo))

(diff-suite)
