; ======================================================================
; Trees, tree entries, treebuilders, blobs, and tags.
; ======================================================================

(println crlf "tree-blob-test-suite")

(deffunction tree-suite ()
  (bind ?repo (make-repo "trees"))
  (system "mkdir -p tests/tmp/trees/dir")
  (write-file ?repo "a.txt" (str-cat "alpha" ?*nl*))
  (write-file ?repo "dir/b.txt" (str-cat "beta" ?*nl*))
  (bind ?id (commit-all ?repo "two files"))
  (bind ?c (git-commit-lookup ?repo ?id))
  (bind ?tree (git-commit-tree ?c))
  (bind ?alpha (git-odb-hash (str-cat "alpha" ?*nl*) GIT_OBJECT_BLOB))

  (expect "the tree has two entries" 2 (git-tree-entrycount ?tree))
  (bind ?e0 (git-tree-entry-byindex ?tree 0))
  (expect "git-tree-entry-byindex answers the first" "a.txt" (git-tree-entry-name ?e0))
  (expect "which is a blob" GIT_OBJECT_BLOB (git-tree-entry-type ?e0))
  (expect "with the blob filemode" GIT_FILEMODE_BLOB (git-tree-entry-filemode ?e0))
  (expect "and the raw filemode" GIT_FILEMODE_BLOB (git-tree-entry-filemode-raw ?e0))
  (expect "and the content's id" ?alpha (git-tree-entry-id ?e0))
  (bind ?r (git-tree-entry-byindex ?tree 9))
  (expect "and refuses an index past the end" FALSE ?r)

  (bind ?dir (git-tree-entry-byname ?tree "dir"))
  (expect "git-tree-entry-byname finds the directory" GIT_OBJECT_TREE (git-tree-entry-type ?dir))
  (expect "with the tree filemode" GIT_FILEMODE_TREE (git-tree-entry-filemode ?dir))
  (bind ?r (git-tree-entry-byname ?tree "nothing"))
  (expect "and refuses a name that is not there" FALSE ?r)
  (bind ?byid (git-tree-entry-byid ?tree ?alpha))
  (expect "git-tree-entry-byid finds by content" "a.txt" (git-tree-entry-name ?byid))
  (expect-true "git-tree-entry-cmp orders entries" (< (git-tree-entry-cmp ?e0 ?dir) 0))

  ; A borrowed entry is freed with its tree. An entry from bypath belongs to
  ; the caller.
  (bind ?r (git-tree-entry-free ?e0))
  (expect "a borrowed entry is not freed on its own" FALSE ?r)
  (bind ?deep (git-tree-entry-bypath ?tree "dir/b.txt"))
  (expect "git-tree-entry-bypath reaches into a subtree" "b.txt" (git-tree-entry-name ?deep))
  (bind ?dupe (git-tree-entry-dup ?deep))
  (expect "git-tree-entry-dup copies it" "b.txt" (git-tree-entry-name ?dupe))
  (expect "and the copy is freed on its own" TRUE (git-tree-entry-free ?dupe))
  (bind ?obj (git-tree-entry-to-object ?repo ?deep))
  (expect "git-tree-entry-to-object answers the blob" (str-cat "beta" ?*nl*) (git-blob-rawcontent ?obj))
  (git-blob-free ?obj)
  (expect "a path entry is freed on its own" TRUE (git-tree-entry-free ?deep))

  (expect "git-tree-walk lists every path" (create$ "a.txt" "dir/" "dir/b.txt") (git-tree-walk ?tree))
  (expect "in post-order when asked" (create$ "a.txt" "dir/b.txt" "dir/") (git-tree-walk ?tree GIT_TREEWALK_POST))

  ; A free of the tree also frees the borrowed entries.
  (bind ?before (git-handle-count))
  (git-tree-free ?tree)
  ; the tree, and two borrowed entries (byindex and byid are one pointer)
  (expect "freeing a tree forgets its borrowed entries" (- ?before 3) (git-handle-count))
  (bind ?r (git-tree-entry-name ?e0))
  (expect "and a borrowed entry is refused afterwards" FALSE ?r)

  ; Blobs.
  (bind ?blob (git-blob-lookup ?repo ?alpha))
  (expect "git-blob-rawcontent is the content" (str-cat "alpha" ?*nl*) (git-blob-rawcontent ?blob))
  (expect "git-blob-rawsize is its length" 6 (git-blob-rawsize ?blob))
  (expect "git-blob-is-binary is false for text" FALSE (git-blob-is-binary ?blob))
  (expect "git-blob-id is the id" ?alpha (git-blob-id ?blob))
  (expect "git-blob-filter answers the content with no filters" (str-cat "alpha" ?*nl*) (git-blob-filter ?blob "a.txt"))
  (bind ?byprefix (git-blob-lookup-prefix ?repo (sub-string 1 6 ?alpha)))
  (expect "git-blob-lookup-prefix finds it" (str-cat "alpha" ?*nl*) (git-blob-rawcontent ?byprefix))
  (git-blob-free ?byprefix)
  (git-blob-free ?blob)

  (bind ?new (git-blob-create-from-buffer ?repo (str-cat "gamma" ?*nl*)))
  (expect-true "git-blob-create-from-buffer writes a blob" (eq (str-length ?new) 40))
  (write-file ?repo "c.txt" (str-cat "gamma" ?*nl*))
  (expect "git-blob-create-from-workdir writes the same" ?new (git-blob-create-from-workdir ?repo "c.txt"))
  (expect "and so does git-blob-create-from-disk" ?new (git-blob-create-from-disk ?repo "tests/tmp/trees/c.txt"))

  ; A treebuilder: start from the tree of the commit, add the new blob, and
  ; write.
  (bind ?tree (git-commit-tree ?c))
  (bind ?bld (git-treebuilder-new ?repo ?tree))
  (expect "git-treebuilder-new starts with the tree's entries" 2 (git-treebuilder-entrycount ?bld))
  (bind ?ins (git-treebuilder-insert ?bld "c.txt" ?new GIT_FILEMODE_BLOB))
  (expect "git-treebuilder-insert answers the entry" "c.txt" (git-tree-entry-name ?ins))
  (expect "and the count grows" 3 (git-treebuilder-entrycount ?bld))
  (bind ?got (git-treebuilder-get ?bld "c.txt"))
  (expect "git-treebuilder-get finds it" ?new (git-tree-entry-id ?got))
  (expect "git-treebuilder-remove takes one out" TRUE (git-treebuilder-remove ?bld "a.txt"))
  (expect "and the count shrinks" 2 (git-treebuilder-entrycount ?bld))
  (bind ?written (git-treebuilder-write ?bld))
  (expect-true "git-treebuilder-write answers a tree id" (eq (str-length ?written) 40))
  (bind ?t2 (git-tree-lookup ?repo ?written))
  (expect "and the tree has what was built" (create$ "c.txt" "dir/" "dir/b.txt") (git-tree-walk ?t2))
  (git-tree-free ?t2)
  (bind ?t2 (git-tree-lookup-prefix ?repo (sub-string 1 10 ?written)))
  (expect "git-tree-lookup-prefix finds it by prefix" ?written (git-tree-id ?t2))
  (git-tree-free ?t2)
  (expect "git-treebuilder-clear empties it" TRUE (git-treebuilder-clear ?bld))
  (expect "to nothing" 0 (git-treebuilder-entrycount ?bld))
  (git-treebuilder-free ?bld)
  (bind ?empty (git-treebuilder-new ?repo))
  (expect "git-treebuilder-new without a tree is empty" 0 (git-treebuilder-entrycount ?empty))
  (git-treebuilder-free ?empty)
  (git-tree-free ?tree)

  ; Tags.
  (bind ?light (git-tag-create-lightweight ?repo "v0" ?c))
  (expect "git-tag-create-lightweight answers the commit id" ?id ?light)
  (bind ?annotated (git-tag-create ?repo "v1" ?c nil (str-cat "release one" ?*nl*)))
  (expect-true "git-tag-create answers the tag's id" (and (eq (str-length ?annotated) 40) (neq ?annotated ?id)))
  (expect "git-tag-list has both" (create$ "v0" "v1") (git-tag-list ?repo))
  (expect "git-tag-list takes a pattern" (create$ "v1") (git-tag-list ?repo "v1*"))
  (bind ?tag (git-tag-lookup ?repo ?annotated))
  (expect "git-tag-name is the name" "v1" (git-tag-name ?tag))
  (expect "git-tag-message is the message" (str-cat "release one" ?*nl*) (git-tag-message ?tag))
  (expect "git-tag-target-id is the commit" ?id (git-tag-target-id ?tag))
  (expect "git-tag-target-type is a commit" GIT_OBJECT_COMMIT (git-tag-target-type ?tag))
  (expect "git-tag-id is the tag" ?annotated (git-tag-id ?tag))
  (bind ?tagger (git-tag-tagger ?tag))
  (expect "git-tag-tagger is the configured user" "Test User" (git-signature-name ?tagger))
  (bind ?target (git-tag-target ?tag))
  (expect "git-tag-target is the commit" ?id (git-commit-id ?target))
  (git-commit-free ?target)
  (bind ?peeled (git-tag-peel ?tag))
  (expect "git-tag-peel is the commit too" ?id (git-object-id ?peeled))
  (git-object-free ?peeled)
  (bind ?byprefix (git-tag-lookup-prefix ?repo (sub-string 1 8 ?annotated)))
  (expect "git-tag-lookup-prefix finds it" "v1" (git-tag-name ?byprefix))
  (git-tag-free ?byprefix)
  (git-tag-free ?tag)
  (bind ?r (git-tag-create ?repo "v1" ?c nil "again"))
  (expect "git-tag-create refuses a name that exists" FALSE ?r)
  (bind ?forced (git-tag-create ?repo "v1" ?c nil "again" TRUE))
  (expect-true "unless forced" (stringp ?forced))
  (bind ?anno (git-tag-annotation-create ?repo "v2" ?c nil "not a ref"))
  (expect-true "git-tag-annotation-create writes a tag object" (eq (str-length ?anno) 40))
  (expect "without a reference" (create$ "v0" "v1") (git-tag-list ?repo))
  (expect "git-tag-delete removes one" TRUE (git-tag-delete ?repo "v0"))
  (expect "and it is gone" (create$ "v1") (git-tag-list ?repo))

  (git-commit-free ?c)
  (git-repository-free ?repo))

(tree-suite)
