#!/usr/bin/env sh
# CLIPSgit @VERSION@
#
# The installed binary is in libexec. This wrapper starts it, and this wrapper
# is the file on PATH. libgit2 is linked statically into the binary, so the
# loader does not need a library path.
case "$1" in
  -v|-V|--version)
    echo "CLIPSgit @VERSION@"
    exit 0
    ;;
esac
exec "@REAL@" "$@"
